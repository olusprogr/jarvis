GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
JARVIS_API_KEY=
HOST=0.0.0.0
PORT=8420
WHISPER_MODEL_SIZE=base
WHISPER_COMPUTE_TYPE=int8
VAULT_DIR=/apps/homeserver/jarvis-brain/vault


# Telegram bot (app/telegram_bot.py) -- get a token from @BotFather, then set
# TELEGRAM_ALLOWED_CHAT_ID to your own chat_id (bootstraps by logging any chat_id that
# messages the bot while this is empty -- see README).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_ID=

# Email (app/tools/email_tool.py) -- Gmail App Password (myaccount.google.com/apppasswords),
# not OAuth. Change EMAIL_IMAP_HOST/EMAIL_SMTP_HOST if not using Gmail.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# ElevenLabs TTS (app/tts.py) -- optional, best quality, the only paid backend.
# Leave empty to use the free Edge/Gemini/Piper chain. Voice IDs: elevenlabs.io -> Voices.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_flash_v2_5

